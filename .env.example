# Конфигурация Supabase.
# Значения берутся из .env существующего веб-проекта (planet-kids-portal).
# Файл .env хранится в git: в нём только публичные значения.
# Всё с префиксом EXPO_PUBLIC_ попадает в бандл приложения и публично:
# секретов (service_role, ключей SMS-шлюза) здесь быть не должно.
# Локальные переопределения кладите в .env.local — он в git не попадает.

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key

# Необязательные ссылки центра для экрана «Настройки».
# Пока не заданы, приложение вместо перехода показывает контакты центра.
# Принимаются только https://, mailto: и tel:.

EXPO_PUBLIC_SUPPORT_URL=
EXPO_PUBLIC_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=

# Тестовый код 1234 без SMS-шлюза. В сборке для разработки он работает
# всегда; в релизной — только при значении true. Не включайте для сторов.
EXPO_PUBLIC_ALLOW_TEST_OTP=
